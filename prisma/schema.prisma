generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String             @unique
  password          String
  role              String             @default("customer")
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  resetToken        String?            @unique
  resetTokenExpires DateTime?
  referralCode      String?            @unique
  referralsMade     Referral[]         @relation("ReferralMade")
  referralReceived  Referral[]         @relation("ReferralReceived")
  addresss           Address[]
  cartItems         CartItem[]
  chatThreads       ChatThread[]
  orders            Order[]
  reviews           Review[]
  loyalty           UserLoyalty?
  subscriptions     UserSubscription[]
  walletBalance     Float              @default(0)
  walletTransaction WalletTransaction[]
}

model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  refereeId     String
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  rewardedAt    DateTime?

  referrer User @relation("ReferralMade", fields: [referrerId], references: [id])
  referee  User @relation("ReferralReceived", fields: [refereeId], references: [id])

  @@unique([referrerId, refereeId])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  image    String?
  type     String    @default("kahve")
  products Product[]
}

model Product {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String                     @unique
  description               String
  price                     Float
  compareAt                 Float?
  images                    String                     @default("[]")
  stock                     Int                        @default(0)
  weight                    Int?
  origin                    String?
  region                    String?
  altitude                  String?
  process                   String?
  variety                   String?
  grade                     String?
  roastLevel                String?
  roastedAt                 DateTime?
  flavorNotes               String?
  body                      String?
  acidity                   String?
  segment                   String?
  featured                  Boolean                    @default(false)
  published                 Boolean                    @default(false)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  categoryId                String
  isBestSeller              Boolean                    @default(false)
  isNewArrival              Boolean                    @default(false)
  earnRate                  Float                      @default(5.0)
  loyaltyExcluded           Boolean                    @default(false)
  cartItems                 CartItem[]
  orderItems                OrderItem[]
  priceLogs                  PriceLog[]
  category                  Category                   @relation(fields: [categoryId], references: [id])
  purchaseOrderItems         PurchaseOrderItem[]
  reviews                   Review[]
  stockLogs                  StockLog[]
  stockNotifications        StockNotification[]
  freshnessNotifications   FreshnessNotification[]
  subscriptionDeliveryItems SubscriptionDeliveryItem[]
  status                    String                     @default("active")
  estimatedRoastAt          DateTime?
  seasonNote                String?
  greenBeanKg               Float?
}

model CartItem {
  id        String   @id @default(cuid())
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  userId    String
  productId String
  grind     String   @default("whole")
  weight    Int      @default(250)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, weight, grind])
}

model Order {
  id              String         @id @default(cuid())
  status          String         @default("pending")
  total           Float
  shippingName    String?
  shippingAddress String?
  shippingCity    String?
  shippingPhone   String?
  paymentMethod   String?
  paymentId       String?
  estimatedDeliveryDate DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          String
  cargoCompany    String?
  trackingNumber  String?
  ipAddress       String?
  user            User           @relation(fields: [userId], references: [id])
  items           OrderItem[]
  ReturnRequest   ReturnRequest?
}

model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int
  price     Float
  openedAt  DateTime?
  consumedAt DateTime?
  rating    Int?
  review    String?
  createdAt DateTime @default(now())
  orderId   String
  productId String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  userId    String
  productId String
  approved  Boolean  @default(false)
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model ChatThread {
  id        String        @id @default(cuid())
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    String
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String     @id @default(cuid())
  role      String
  content   String
  createdAt DateTime   @default(now())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  description     String
  price           Float
  packageCount    Int                @default(1)
  packageSize     Int                @default(250)
  hasDiscovery    Boolean            @default(false)
  hasSpecialty    Boolean            @default(false)
  hasPriority     Boolean            @default(false)
  discountPercent Int                @default(0)
  tier            String             @default("daily")
  brewMethod      String             @default("filter")
  isActive        Boolean            @default(true)
  sortOrder       Int                @default(0)
  stripePriceId   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  subscriptions   UserSubscription[]
}

model UserSubscription {
  id                   String                 @id @default(cuid())
  status               String                 @default("active")
  startDate            DateTime               @default(now())
  nextDelivery         DateTime?
  pauseDate            DateTime?
  cancelledDate        DateTime?
  equipment            String?
  grindSetting         String?
  flavorProfile        String?
  roastPreference      String?
  brewMethod           String                 @default("filter")
  deliveryFrequency    String                 @default("monthly")
  packageCount         Int?
  notes                String?
  stripeSubscriptionId String?                @unique
  stripeCustomerId     String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  userId               String
  planId               String
  deliveries           SubscriptionDelivery[]
  plan                 SubscriptionPlan       @relation(fields: [planId], references: [id])
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubscriptionDelivery {
  id             String                     @id @default(cuid())
  status         String                     @default("pending")
  roastDate      DateTime?
  shipDate       DateTime?
  deliveredDate  DateTime?
  trackingNumber String?
  trackingUrl    String?
  packageCount   Int
  notes          String?
  rating         Int?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  subscriptionId String
  subscription   UserSubscription           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  items          SubscriptionDeliveryItem[]
}

model SubscriptionDeliveryItem {
  id         String               @id @default(cuid())
  quantity   Int                  @default(1)
  deliveryId String
  productId  String
  delivery   SubscriptionDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product    Product              @relation(fields: [productId], references: [id])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  group String @default("general")
}

model MenuItem {
  id        String     @id @default(cuid())
  label     String
  href      String
  parentId  String?
  sortOrder Int        @default(0)
  isVisible Boolean    @default(true)
  icon      String?
  group     String     @default("header")
  parent    MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id])
  children  MenuItem[] @relation("MenuHierarchy")
}

model CustomPage {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   String
  template  String   @default("default")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String   @default("footer")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockNotification {
  id        String   @id @default(cuid())
  email     String
  productId String
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model FreshnessNotification {
  id                String   @id @default(cuid())
  email             String
  productId         String
  lastNotifiedPhase String?  // "resting" | "prepeak" | "peak" | "maturity" | "end"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([email, productId])
  @@map("FreshnessNotification")
}

model LoyaltySettings {
  id                      String   @id @default("global")
  earnRatePct             Float    @default(5.0)
  pendingDays             Int      @default(14)
  monthlyCapKurus         Int      @default(150000)
  freeShippingThresholdKurus Int   @default(100000)
  shippingCostKurus       Int      @default(15000)

  referralRewardKurus     Int      @default(10000)
  referralFriendDiscountPct Float  @default(10)
  subscriptionDiscountPct Float    @default(5)
  dailyRoastCapacity      Int      @default(50)
  greenBeanThreshold      Float    @default(20)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model UserLoyalty {
  id            String               @id @default(cuid())
  userId        String               @unique
  points        Int                  @default(0)
  totalSpent    Float                @default(0)
  tier          String               @default("bronze")
  birthDate     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  pendingPoints Int                  @default(0)
  transactions  LoyaltyTransaction[]
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoyaltyTransaction {
  id          String      @id @default(cuid())
  userId      String
  loyaltyId   String
  amount      Int
  type        String
  reference   String?
  note        String?
  createdAt   DateTime    @default(now())
  availableAt DateTime?
  orderId     String?
  status      String      @default("pending")
  loyalty     UserLoyalty @relation(fields: [loyaltyId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Float
  type      String   // "top_up" | "payment" | "refund" | "admin_adjust"
  status    String   @default("pending") // "pending" | "completed" | "cancelled"
  reference String?  // admin note or bank reference
  note      String?
  orderId   String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HomepageBlock {
  id        String   @id @default(cuid())
  section   String   @default("hero")
  blockType String   @default("hero-kahveni-bul")
  title     String   @default("")
  subtitle  String   @default("")
  content   String   @default("")
  imageUrl  String   @default("")
  imageSize String   @default("w-[420px] h-[420px] lg:w-[600px] lg:h-[600px]")
  linkUrl   String   @default("")
  linkText  String   @default("")
  badgeText String   @default("")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  styles    String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  audioUrl  String   @default("")
}

model Address {
  id        String   @id @default(cuid())
  name      String   @default("default")
  fullName  String
  address   String
  city      String
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model B2BContent {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  icon        String?
  step        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlockedIp {
  id         String    @id @default(cuid())
  ip         String    @unique
  reason     String    @default("manual")
  orderCount Int       @default(0)
  blockedAt  DateTime  @default(now())
  expiresAt  DateTime?
  note       String?
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  posts     BlogPost[]
}

model BlogPost {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  excerpt      String
  content      String
  imageUrl     String?
  author       String        @default("Rostello")
  published    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime @updatedAt
  categoryId   String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])
  tags       BlogPostTag[]
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model BlogTag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())
  posts     BlogPostTag[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminNotification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  discountPct  Float     @default(0)
  discountLira Float     @default(0)
  minAmount    Float     @default(0)
  maxUses      Int       @default(0)
  useCount     Int       @default(0)
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

model EmailLog {
  id             String   @id @default(cuid())
  subject        String
  body           String
  recipientCount Int      @default(0)
  sentAt         DateTime @default(now())
}

model Equipment {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Float
  salePrice   Float?
  image       String
  soldOut     Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sortOrder   Int      @default(0)
}

model FilmReelItem {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String?
  subtitle  String?
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KavurumhaneInfo {
  id          String   @id @default("global")
  title       String   @default("Kavurumhane")
  description String   @default("")
  address     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KavurumhaneProcess {
  id          String   @id @default(cuid())
  step        String
  title       String
  description String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PriceLog {
  id        String   @id @default(cuid())
  productId String
  oldPrice  Float    @default(0)
  newPrice  Float    @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  status            String              @default("pending")
  total             Float               @default(0)
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime @updatedAt
  supplierId        String
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  quantity        Int           @default(1)
  unitPrice       Float         @default(0)
  purchaseOrderId String
  productId       String
  product   Product       @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model ReturnRequest {
  id             String   @id @default(cuid())
  reason         String
  status         String   @default("pending")
  cargoCompany   String?
  trackingNumber String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orderId        String   @unique
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model SignatureProduct {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  price       Float
  salePrice   Float?
  image       String
  category    String   @default("Aksesuar")
  sizes       String   @default("[]")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sortOrder   Int      @default(0)
}

model StockLog {
  id        String   @id @default(cuid())
  productId String
  oldStock  Int      @default(0)
  newStock  Int      @default(0)
  change    Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  city      String?
  phone     String?
  email     String?
  latitude  Float?
  longitude Float?
  image     String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  contactName   String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
}

model TasteTestResult {
  id        String   @id @default(cuid())
  userId    String?
  name      String?
  email     String?
  how       String
  equipment String
  flavor    String
  roast     String
  results   String
  userAgent String?
  createdAt DateTime @default(now())
}

model Workshop {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  date        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
